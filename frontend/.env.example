# Frontend env (Vite — VITE_* vars are exposed to the browser).
# Copy to .env.local and fill in. .env.local is gitignored.

# Bearer token to authenticate against the orchestrator API.
# Must match API_TOKEN in the backend .env. Generated by `make token`.
VITE_API_TOKEN=

# Base URL of the orchestrator API. Leave empty to use a relative path
# (works in production where FastAPI serves both / and /api). Set this
# in dev only if vite proxy is not enough (e.g. SSE through a tunnel).
VITE_API_BASE=
