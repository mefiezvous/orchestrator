  "components": {
    "schemas": {
      "CheckpointResponse": {
        "properties": {
          "robot": {
            "type": "string",
            "title": "Robot"
          },
          "policy": {
            "type": "string",
            "title": "Policy"
          },
          "step": {
            "type": "integer",
            "title": "Step"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "modified_at": {
            "type": "string",
            "title": "Modified At"
          }
        },
        "type": "object",
        "required": [
          "robot",
          "policy",
          "step",
          "path",
          "size_bytes",
          "modified_at"
        ],
        "title": "CheckpointResponse"
      },
      "CollectRequest": {
        "properties": {
          "episodes": {
            "type": "integer",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Episodes",
            "default": 10
          },
          "env": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Env"
          },
          "policy_type": {
            "type": "string",
            "enum": [
              "scripted",
              "teleop"
            ],
            "title": "Policy Type",
            "default": "scripted"
          },
          "push_to_hub": {
            "type": "boolean",
            "title": "Push To Hub",
            "default": false
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "hydra_overrides": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hydra Overrides"
          }
        },
        "type": "object",
        "title": "CollectRequest"
      },
      "DatasetResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "modified_at": {
            "type": "string",
            "title": "Modified At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "path",
          "size_bytes",
          "modified_at"
        ],
        "title": "DatasetResponse"
      },
      "EvalReportResponse": {
        "properties": {
          "robot": {
            "type": "string",
            "title": "Robot"
          },
          "policy": {
            "type": "string",
            "title": "Policy"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "modified_at": {
            "type": "string",
            "title": "Modified At"
          },
          "has_video": {
            "type": "boolean",
            "title": "Has Video"
          },
          "summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "robot",
          "policy",
          "path",
          "size_bytes",
          "modified_at",
          "has_video",
          "summary"
        ],
        "title": "EvalReportResponse"
      },
      "EvalRequest": {
        "properties": {
          "checkpoint_path": {
            "type": "string",
            "title": "Checkpoint Path"
          },
          "n_episodes": {
            "type": "integer",
            "maximum": 1000.0,
            "exclusiveMinimum": 0.0,
            "title": "N Episodes",
            "default": 50
          },
          "visualize": {
            "type": "boolean",
            "title": "Visualize",
            "default": false
          },
          "policy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "act",
                  "diffusion"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy"
          },
          "hydra_overrides": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hydra Overrides"
          }
        },
        "type": "object",
        "required": [
          "checkpoint_path"
        ],
        "title": "EvalRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "api": {
            "type": "string",
            "const": "ok",
            "title": "Api"
          },
          "redis": {
            "type": "string",
            "enum": [
              "ok",
              "down",
              "unknown"
            ],
            "title": "Redis"
          },
          "mlflow": {
            "type": "string",
            "enum": [
              "ok",
              "down",
              "unknown"
            ],
            "title": "Mlflow"
          },
          "workspace": {
            "type": "string",
            "enum": [
              "ok",
              "missing"
            ],
            "title": "Workspace"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "api",
          "redis",
          "mlflow",
          "workspace",
          "database"
        ],
        "title": "HealthResponse"
      },
      "HydraConfigResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "group": {
            "type": "string",
            "title": "Group"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "fields": {
            "additionalProperties": true,
            "type": "object",
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "name",
          "group",
          "path",
          "fields"
        ],
