# orchestrator — copy to .env and fill in. Never commit .env.

# API authentication — generated by `make token`
API_TOKEN=

# Bind address. Default 127.0.0.1 (loopback only). Set ALLOW_LAN=true to bind 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8000
ALLOW_LAN=false

# Workspace layout. WORKSPACE_ROOT contains the sibling sub-repos.
WORKSPACE_ROOT=/workspace
LEROBOT_REPO=${WORKSPACE_ROOT}/lerobot-playground-portfolio

# Data directory (datasets, checkpoints, mlruns, eval_reports, logs, runs.db)
DATA_DIR=/data

# SQLite (jobs metadata only — metrics live in MLflow)
DATABASE_URL=sqlite:///${DATA_DIR}/runs.db

# Redis (RQ queue + pub/sub for SSE metrics)
REDIS_URL=redis://redis:6379/0

# MLflow tracking (file backend by default)
MLFLOW_TRACKING_URI=file://${DATA_DIR}/mlruns

# Optional integrations — passed through to subprocess jobs
HF_TOKEN=
WANDB_API_KEY=

# Logging
LOG_LEVEL=INFO
